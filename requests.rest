@localUrl = http://localhost:8080
@renderUrl = https://medieval-quest-api.onrender.com

### Get all quests
GET {{localUrl}}/quests

### Create a quest
POST {{localUrl}}/quests
Content-Type: application/json

{
  "title": "The Missing Blacksmith Hammer",
  "description": "Find the blacksmith's missing hammer and return it to the forge.",
  "difficulty": "easy",
  "location": "Embercrest Forge",
  "reward": "10 gold coins",
  "minimumLevel": 1,
  "guildId": null
}

### Get all quests on Render
GET {{renderUrl}}/quests

### Create a quest on Render
POST {{renderUrl}}/quests
Content-Type: application/json

{
  "title": "Supplies for the Watchtower",
  "description": "Deliver supplies to the guards at the northern watchtower.",
  "difficulty": "easy",
  "location": "Northern Watchtower",
  "reward": "15 gold coins",
  "minimumLevel": 1,
  "guildId": null
}