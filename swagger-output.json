{
  "openapi": "3.0.0",
  "info": {
    "title": "Medieval Quest API",
    "version": "1.1.0",
    "description": "Lesson 6: Create, retrieve, update, and delete medieval quests. Includes input validation and error handling. Quests may optionally be linked to an existing guild."
  },
  "servers": [
    {
      "url": "/",
      "description": "Server hosting this documentation"
    }
  ],
  "tags": [
    {
      "name": "General",
      "description": "API welcome route."
    },
    {
      "name": "Quests",
      "description": "Create, retrieve, update, and delete quests."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Get the welcome message",
        "responses": {
          "200": {
            "description": "API welcome message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Welcome to the Medieval Quest API!"
                }
              }
            }
          }
        }
      }
    },
    "/quests": {
      "get": {
        "tags": [
          "Quests"
        ],
        "summary": "Get all quests",
        "description": "Returns all quests, optionally filtered by difficulty. An empty result returns []. Only the difficulty query parameter is supported.",
        "parameters": [
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "description": "Optional filter. Use exactly easy, medium, or hard.",
            "schema": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quests retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Quest"
                  }
                },
                "example": [
                  {
                    "_id": "6acd46de25042f01b90c3644",
                    "title": "A Message for the Gatekeeper",
                    "description": "Deliver a sealed message to the kingdom gatekeeper.",
                    "difficulty": "easy",
                    "location": "Main Gate",
                    "reward": "5 gold coins",
                    "minimumLevel": 1,
                    "guildId": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Invalid difficulty or an unsupported query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "difficulty must be easy, medium, or hard"
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve quests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Unable to retrieve quests"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Quests"
        ],
        "summary": "Create a quest",
        "description": "Validates the quest fields and any supplied guild ID, saves the quest in MongoDB, and returns its new ID.",
        "requestBody": {
          "required": true,
          "description": "Provide all six required fields. Additional fields are ignored. Omit guildId or use null for an unassigned quest. On PUT, omitting guildId clears any previous guild assignment.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestInput"
              },
              "example": {
                "title": "A Message for the Gatekeeper",
                "description": "Deliver a sealed message to the kingdom gatekeeper.",
                "difficulty": "easy",
                "location": "Main Gate",
                "reward": "5 gold coins",
                "minimumLevel": 1,
                "guildId": null
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Quest created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "id"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-fA-F0-9]{24}$",
                      "example": "6acd46de25042f01b90c3644"
                    }
                  }
                },
                "example": {
                  "message": "Quest created successfully!",
                  "id": "6acd46de25042f01b90c3644"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or quest data. Check the response message for details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "minimumLevel must be a whole number of at least 1"
                }
              }
            }
          },
          "413": {
            "description": "The JSON request exceeds the server body-size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request body is too large"
                }
              }
            }
          },
          "500": {
            "description": "Unable to create quest.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Unable to create quest"
                }
              }
            }
          }
        }
      }
    },
    "/quests/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "MongoDB quest ID. Copy an actual _id from GET /quests.",
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "example": "6acd46de25042f01b90c3644"
          }
        }
      ],
      "get": {
        "tags": [
          "Quests"
        ],
        "summary": "Get a quest by ID",
        "description": "Returns the quest matching the supplied ID.",
        "responses": {
          "200": {
            "description": "Quest retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quest"
                },
                "example": {
                  "_id": "6acd46de25042f01b90c3644",
                  "title": "A Message for the Gatekeeper",
                  "description": "Deliver a sealed message to the kingdom gatekeeper.",
                  "difficulty": "easy",
                  "location": "Main Gate",
                  "reward": "5 gold coins",
                  "minimumLevel": 1,
                  "guildId": null
                }
              }
            }
          },
          "400": {
            "description": "The quest ID is not a valid 24-character hexadecimal MongoDB ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Please provide a valid quest ID"
                }
              }
            }
          },
          "404": {
            "description": "The ID is valid, but no quest has that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Quest not found"
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve quest.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Unable to retrieve quest"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Quests"
        ],
        "summary": "Update a quest",
        "description": "Updates all seven editable fields of an existing quest. All six required fields must be supplied. Returns 204 with no response body on success, including when the submitted values are unchanged.",
        "requestBody": {
          "required": true,
          "description": "Provide all six required fields. Additional fields are ignored. Omit guildId or use null for an unassigned quest. On PUT, omitting guildId clears any previous guild assignment.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestInput"
              },
              "example": {
                "title": "A Message for the Gatekeeper",
                "description": "Deliver a sealed message to the kingdom gatekeeper.",
                "difficulty": "easy",
                "location": "Main Gate",
                "reward": "5 gold coins",
                "minimumLevel": 1,
                "guildId": null
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Quest updated successfully. No response body."
          },
          "400": {
            "description": "Invalid quest ID, malformed JSON, or invalid quest fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "minimumLevel must be a whole number of at least 1"
                }
              }
            }
          },
          "404": {
            "description": "The ID is valid, but no quest has that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Quest not found"
                }
              }
            }
          },
          "413": {
            "description": "The JSON request exceeds the server body-size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Request body is too large"
                }
              }
            }
          },
          "500": {
            "description": "Unable to update quest.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Unable to update quest"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Quests"
        ],
        "summary": "Delete a quest",
        "description": "Permanently removes the quest matching the supplied ID.",
        "responses": {
          "200": {
            "description": "Quest deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Quest deleted successfully!"
                }
              }
            }
          },
          "400": {
            "description": "The quest ID is not a valid 24-character hexadecimal MongoDB ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Please provide a valid quest ID"
                }
              }
            }
          },
          "404": {
            "description": "The ID is valid, but no quest has that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Quest not found"
                }
              }
            }
          },
          "500": {
            "description": "Unable to delete quest.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Unable to delete quest"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QuestInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "difficulty",
          "location",
          "reward",
          "minimumLevel"
        ],
        "properties": {
          "title": {
            "type": "string",
            "pattern": "\\S",
            "description": "Quest title. Cannot be blank."
          },
          "description": {
            "type": "string",
            "pattern": "\\S",
            "description": "Instructions for completing the quest. Cannot be blank."
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "description": "Difficulty is trimmed and converted to lowercase."
          },
          "location": {
            "type": "string",
            "pattern": "\\S",
            "description": "Where the quest takes place. Cannot be blank."
          },
          "reward": {
            "type": "string",
            "pattern": "\\S",
            "description": "Reward for completing the quest. Cannot be blank."
          },
          "minimumLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Minimum player level. Must be a whole number."
          },
          "guildId": {
            "type": "string",
            "nullable": true,
            "pattern": "^[a-fA-F0-9]{24}$",
            "description": "Existing guild ID, or null for an unassigned quest. Omitting this field also makes the quest unassigned."
          }
        }
      },
      "Quest": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "description",
          "difficulty",
          "location",
          "reward",
          "minimumLevel",
          "guildId"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "example": "6acd46de25042f01b90c3644"
          },
          "title": {
            "type": "string",
            "pattern": "\\S",
            "description": "Quest title. Cannot be blank."
          },
          "description": {
            "type": "string",
            "pattern": "\\S",
            "description": "Instructions for completing the quest. Cannot be blank."
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "description": "Difficulty is trimmed and converted to lowercase."
          },
          "location": {
            "type": "string",
            "pattern": "\\S",
            "description": "Where the quest takes place. Cannot be blank."
          },
          "reward": {
            "type": "string",
            "pattern": "\\S",
            "description": "Reward for completing the quest. Cannot be blank."
          },
          "minimumLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Minimum player level. Must be a whole number."
          },
          "guildId": {
            "type": "string",
            "nullable": true,
            "pattern": "^[a-fA-F0-9]{24}$",
            "description": "Existing guild ID, or null for an unassigned quest. Omitting this field also makes the quest unassigned."
          }
        }
      }
    }
  }
}